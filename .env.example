# 복사해 .env.local 로 쓴다. VITE_* 는 브라우저 코드에 그대로 들어가므로 비밀값을 넣지 않는다.

# API 기준 주소. 서버와 같은 origin 으로 배포하므로 경로만 적는다 (예: /api/v1)
VITE_API_BASE_URL=

# 지도 타일 주소 템플릿. {z}, {x}, {y} 를 포함한다 (예: https://tile.openstreetmap.org/{z}/{x}/{y}.png)
VITE_MAP_TILE_URL=

# 개발 서버 전용. /api 요청을 넘길 OTA Server 주소. 비우면 http://localhost:8080 (브라우저 코드에 들어가지 않는다)
DEV_PROXY_TARGET=
