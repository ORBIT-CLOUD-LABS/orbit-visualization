    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
